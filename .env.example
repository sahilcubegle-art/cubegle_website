# ──────────────────────────────────────────────────────────────────────────────
#  Environment variables — Cubegle Website
#  Copy this file to .env.local for local development.
#  Set all variables in the Netlify dashboard: Site > Environment variables
#  NEVER commit .env.local or any file containing real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── SMTP credentials ──────────────────────────────────────────────────────────
# Used by the contact and careers forms (src/lib/mail.ts).
# Required: all four variables must be set for form emails to send.

SMTP_HOST=
SMTP_PORT=587
# Set SMTP_SECURE=true only when using port 465 (implicit TLS).
# Leave unset (or false) for port 587 with STARTTLS.
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Optional: the "From" address shown in delivered emails.
# Defaults to SMTP_USER if unset.
# Format: "Display Name <address@example.com>"
SMTP_FROM=

# ── Site URL (optional, for absolute URL generation) ──────────────────────────
# Needed if you add open-graph image generation or absolute canonical URLs
# beyond what is already set in src/config/site.ts.
# NEXT_PUBLIC_SITE_URL=https://www.cubegle.com
