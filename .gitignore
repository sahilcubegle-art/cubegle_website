# ──────────────────────────────────────────────
#  Production .gitignore — Cubegle Website
# ──────────────────────────────────────────────

# ── Node / package managers ──────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Next.js build output ──────────────────────
.next
out
dist

# ── Netlify ───────────────────────────────────
.netlify

# ── Environment / secrets ─────────────────────
# Never commit real env files — set these in Netlify's dashboard instead.
.env
.env.local
.env.*.local
# Keep the example file so new contributors know what vars are needed.
!.env.example

# ── TypeScript build info ─────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Test / coverage ───────────────────────────
coverage

# ── OS artefacts ─────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE directories ──────────────────
.vscode
.idea

# ── Misc ─────────────────────────────────────
*.pem
